# ─── Database ────────────────────────────────────────────────────────────────
# Local development / VPS: a SQLite file (path is relative to prisma/schema.prisma).
#
# Keep this set on Vercel too, even though Turso is what actually serves requests:
# the Prisma schema reads env("DATABASE_URL"), and `prisma generate` fails during
# the build if it is missing. Any value satisfies it — "file:./dev.db" is fine.
DATABASE_URL="file:./dev.db"

# Production on serverless hosts (Vercel, Netlify…): use Turso / libSQL so data
# persists between deployments. When set, the app uses these instead of the file.
# A SQLite file cannot be used on Vercel — the filesystem is read-only and is
# discarded between requests.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN=""

# ─── Public site ─────────────────────────────────────────────────────────────
# Full public URL, used for canonical links, sitemap and social sharing.
# Optional on Vercel: deployments fall back to their own Vercel domain. Set it to
# your custom domain once you have one, so canonical links point at the real site.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used only by the seed script on first run (can be changed later in Settings).
SITE_NAME="ZimWatchline"
AUTHOR_NAME="Hilda Sena"

# ─── Administrator (single user) ─────────────────────────────────────────────
# Read by `npm run db:seed`, which hashes the password with bcrypt before saving.
# The plain password is never stored. Change it later in Admin → Settings.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-to-a-long-passphrase"
# Set to "true" and re-run the seed to reset the password (signs out all sessions).
ADMIN_RESET_PASSWORD="false"

# ─── Cloudinary (photo & video hosting) ──────────────────────────────────────
# Dashboard → Settings → API Keys. The secret stays on the server; the browser
# only receives short-lived upload signatures.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="journalist-site"
