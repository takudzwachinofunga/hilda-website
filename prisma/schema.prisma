// Prisma schema for the journalist news & media site.
// Local development uses a SQLite file. In production you can point the app at
// Turso/libSQL by setting TURSO_DATABASE_URL (see src/lib/db.ts and README).

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 hash of the random token stored in the cookie.
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model LoginAttempt {
  // Key combines client IP and email, e.g. "ip:1.2.3.4|email:a@b.com".
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  lockedUntil DateTime?
}

model Article {
  id                   String    @id @default(cuid())
  title                String
  slug                 String    @unique
  excerpt              String    @default("")
  content              String    @default("")
  featuredImage        String?
  featuredImageCaption String?
  videoUrl             String?
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eventId              String?
  event                Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventDate            DateTime?
  eventLocation        String?
  // "DRAFT" | "PUBLISHED"
  status               String    @default("DRAFT")
  isFeatured           Boolean   @default(false)
  publishedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tags          Tag[]
  // Media whose primary association is this article.
  media         Media[]   @relation("MediaArticle")
  // Additional photographs shown with the article (reusable across articles).
  galleryImages Media[]   @relation("ArticleGallery")

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([eventId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @default("")
  location    String?
  startDate   DateTime
  endDate     DateTime?
  coverImage  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
  media    Media[]

  @@index([startDate])
}

model Media {
  id           String   @id @default(cuid())
  // "IMAGE" | "VIDEO"
  type         String   @default("IMAGE")
  title        String?
  caption      String?
  url          String
  // Cloudinary public id; null for externally hosted media (e.g. YouTube).
  publicId     String?
  resourceType String?
  thumbnailUrl String?
  width        Int?
  height       Int?
  bytes        Int?
  format       String?
  takenAt      DateTime?
  location     String?
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  articleId    String?
  article      Article? @relation("MediaArticle", fields: [articleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  galleryArticles Article[] @relation("ArticleGallery")

  @@index([type])
  @@index([eventId])
  @@index([articleId])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

// Single-row site configuration (id is always 1).
model Setting {
  id          Int      @id @default(1)
  siteName    String   @default("ZimWatchline")
  tagline     String   @default("Covering the Office of the President — state occasions, regional summits and the national programmes in between.")
  authorName  String   @default("Hilda Sena")
  authorBio   String   @default("")
  authorPhoto String?
  contactEmail String?
  location    String?  @default("Harare, Zimbabwe")
  twitterUrl  String?
  facebookUrl String?
  instagramUrl String?
  youtubeUrl  String?
  linkedinUrl String?
  updatedAt   DateTime @updatedAt
}
